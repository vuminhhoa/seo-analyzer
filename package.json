{
  "name": "@vuminhhoa/seo-analyzer",
  "version": "0.1.0",
  "description": "SEO and readability content analysis library with ready-made React (Shopify Polaris) result components. Based on the yoastseo package by Team Yoast.",
  "keywords": [
    "seo",
    "readability",
    "content-analysis",
    "keyword",
    "yoast",
    "shopify",
    "polaris"
  ],
  "homepage": "https://github.com/vuminhhoa/seo-analyzer#readme",
  "bugs": {
    "url": "https://github.com/vuminhhoa/seo-analyzer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vuminhhoa/seo-analyzer.git"
  },
  "license": "GPL-3.0-or-later",
  "author": "Vu Minh Hoa <hoavm.dev@gmail.com> (https://github.com/vuminhhoa)",
  "contributors": [
    "Team Yoast (https://yoast.com) - original yoastseo package"
  ],
  "main": "build/index.js",
  "types": "types/index.d.ts",
  "files": [
    "build/",
    "types/",
    "LICENSE",
    "NOTICE.md"
  ],
  "sideEffects": [
    "*.scss",
    "*.css"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "yarn clean && yarn build:js && yarn build:types",
    "build:js": "babel src --copy-files --source-maps --out-dir build",
    "build:types": "tsc",
    "clean": "rm -rf build types",
    "lint": "eslint .",
    "prepublishOnly": "yarn lint && yarn build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "htmlparser2": "^3.9.2",
    "lodash": "^4.18.1",
    "parse5": "^7.1.2",
    "tiny-segmenter": "^0.2.0",
    "tokenizer2": "^2.0.1"
  },
  "peerDependencies": {
    "@shopify/polaris": "^13.9.1",
    "@shopify/polaris-icons": "^8.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.0",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.28.5",
    "@eslint/js": "^9.39.1",
    "@shopify/polaris": "^13.9.1",
    "@shopify/polaris-icons": "^8.2.0",
    "@yoast/browserslist-config": "^1.2.5",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.16.0",
    "globals": "^17.13.0",
    "prettier": "^1.18.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^7.0.2"
  },
  "resolutions": {
    "lodash": "^4.18.1"
  }
}

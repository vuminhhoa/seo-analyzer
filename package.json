{
  "name": "@vuminhhoa/seo-analyzer",
  "version": "0.1.0",
  "description": "SEO and readability content analysis library with ready-made React (Shopify Polaris) result components. Based on the yoastseo package by Team Yoast.",
  "keywords": [
    "seo",
    "readability",
    "content-analysis",
    "keyword",
    "yoast",
    "shopify",
    "polaris"
  ],
  "homepage": "https://github.com/vuminhhoa/seo-analyzer#readme",
  "bugs": {
    "url": "https://github.com/vuminhhoa/seo-analyzer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vuminhhoa/seo-analyzer.git"
  },
  "license": "GPL-3.0-or-later",
  "author": "Vu Minh Hoa <hoavm.dev@gmail.com> (https://github.com/vuminhhoa)",
  "contributors": [
    "Team Yoast (https://yoast.com) - original yoastseo package"
  ],
  "main": "build/index.js",
  "types": "types/index.d.ts",
  "files": [
    "build/",
    "types/",
    "LICENSE",
    "NOTICE.md"
  ],
  "sideEffects": [
    "*.scss",
    "*.css"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.mjs",
    "build": "yarn clean && yarn build:js && yarn build:types",
    "build:js": "babel src --copy-files --source-maps --out-dir build",
    "build:types": "tsc",
    "check:imports": "node scripts/check-imports.js",
    "clean": "rm -rf build types",
    "lint": "eslint . && yarn check:imports",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "yarn lint && yarn test && yarn build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "events": "^3.3.0",
    "htmlparser2": "^3.9.2",
    "lodash": "^4.18.1",
    "parse5": "^7.3.0",
    "tiny-segmenter": "^0.2.0",
    "tokenizer2": "^2.0.1",
    "url": "^0.11.4"
  },
  "peerDependencies": {
    "@shopify/polaris": "^13.9.5",
    "@shopify/polaris-icons": "^9.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.0",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.28.5",
    "@eslint/js": "^9.39.1",
    "@shopify/polaris": "^13.9.5",
    "@shopify/polaris-icons": "^9.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "@yoast/browserslist-config": "^1.2.5",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "jsdom": "25.0.1",
    "prettier": "^3.9.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sass": "1.80.6",
    "typescript": "^5.6.3",
    "vite": "6.4.4",
    "vitest": "2.1.4"
  },
  "resolutions": {
    "lodash": "^4.18.1"
  }
}

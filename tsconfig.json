{
  "include": [
    "src/**.js",
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowJs": true,
    "checkJs": false,
    "outDir": "./types",
    "module": "es2022",
    "paths": {
      "@seo-analyzer/*": ["src/*"],
      "yoastseo": ["src/index.js"]
    },
    "strict": true,
    "skipLibCheck": true,
  }
}
